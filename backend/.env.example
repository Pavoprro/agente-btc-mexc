# Copiar como backend/.env y poner valores reales. El .env NO se sube al repo (está en .gitignore).

# Clave de la API privada (mínimo 16 caracteres). Generar una: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Mercado (datos públicos de MEXC; no hace falta ninguna clave de MEXC)
SIMBOLO=BTCUSDT
INTERVALO=1d
MAX_ANTIGUEDAD_H=36

# Modelo y regla
MODELO_VERSION=v1
UMBRAL=0.0005

# Paper y límites de riesgo (fijos antes de la prueba; el LLM no los puede cambiar)
CAPITAL_INICIAL=50000
COSTO=0.0
EXPOSICION_MAX=1.0
PERDIDA_DIARIA_MAX=0.05

# LLM local (Ollama). Dejar LLM_MODELO vacío para correr solo con la regla del Avance 3
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODELO=
LLM_TIMEOUT_S=60
